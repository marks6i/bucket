{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-linux-x64-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/linux-x64-debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Build using the linux-x64-debug preset"
    },
    {
      "label": "build-windows-x64-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/windows-x64-debug",
        "--config",
        "Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"],
      "detail": "Build using the windows-x64-debug preset"
    }
  ]
}
